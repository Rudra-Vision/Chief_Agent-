# =============================================================================
#  CHIEF AGENT - ENVIRONMENT TEMPLATE
#
#  Copy this file to `.env` and fill in your own values:
#      cp .env.example .env
#
#  NEVER COMMIT THE REAL `.env` FILE. It contains account credentials.
#  `.env` is already listed in .gitignore.
#
#  Anything left blank falls back to safe defaults (the system runs fully in
#  PAPER mode with simulated market data when no broker credentials are present).
# =============================================================================

# ------------------------------------------------------------------ application
APP_NAME="Chief Agent"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------- mode
# SANDBOX | PAPER | LIVE
#   SANDBOX : Upstox sandbox (place/modify/cancel only). No real money.
#   PAPER   : internal paper-trading engine. No broker order calls at all.
#   LIVE    : real money. LOCKED until every prerequisite below is satisfied.
OPERATING_MODE=PAPER

# Live-capital ramp. Never jumps automatically.
# 0=backtest 1=sandbox 2=paper 3=shadow 4=min-live 5=small-live 6=normal-live
DEPLOYMENT_STAGE=2

# Master switch. LIVE cannot be entered at all while this is false.
ALLOW_LIVE_TRADING=false

# ------------------------------------------------------- Upstox API credentials
# Create an app at https://account.upstox.com/developer/apps
# Redirect URI must EXACTLY match the one registered on the app.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/broker/upstox/callback

# Daily access token (regenerate every trading day via the login flow).
# Get it from the dashboard "Connect Upstox" button, or paste it here.
UPSTOX_ACCESS_TOKEN=

# Sandbox token (valid 30 days). Only needed for OPERATING_MODE=SANDBOX orders.
UPSTOX_SANDBOX_TOKEN=

# Optional: a long-lived analytics token for market data / streaming.
UPSTOX_ANALYTICS_TOKEN=

# Registered static IPs (required by the exchange for API order placement).
# These are registered against your Upstox account, not this app.
UPSTOX_STATIC_IP_PRIMARY=
UPSTOX_STATIC_IP_SECONDARY=
REQUIRE_STATIC_IP_FOR_LIVE=true

# Optional: only if you have an exchange-approved algo name.
UPSTOX_ALGO_NAME=

# ------------------------------------------------------------------- database
# Local default is SQLite (zero setup). For a VPS use PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://chief:chief@db:5432/chief_agent
DATABASE_URL=
DATABASE_ECHO=false

# ---------------------------------------------------------------------- redis
# Optional. Leave blank to run without Redis (in-process cache is used).
REDIS_URL=
REDIS_REQUIRED=false

# --------------------------------------------------------------------- server
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------ dashboard authentication
DASHBOARD_USER=owner
# REQUIRED for LIVE mode. Leave blank to disable the login wall in PAPER mode.
DASHBOARD_PASSWORD=
# Change this to a long random string in production.
SECRET_KEY=

# ----------------------------------------------------------------------- data
HISTORICAL_YEARS_TO_CACHE=1
MAX_UNIVERSE_SIZE=120
MARKET_DATA_POLL_SECONDS=1.0
STALE_QUOTE_SECONDS=5.0

# ---------------------------------------------------------------------- AI/LLM
# Optional. The system is fully functional with LLM_PROVIDER=none.
# Options: none | openai_compatible
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
